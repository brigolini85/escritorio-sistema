FROM node:22-slim AS build
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @escritorio/trabalhador build
RUN pnpm deploy --filter @escritorio/trabalhador --prod /saida

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /saida/node_modules ./node_modules
COPY --from=build --chown=node:node /repo/apps/trabalhador/dist ./dist
# Prontidão (D5): sem root; /vivo só diz que o processo responde (WhatsApp fora não reinicia o contêiner em laço).
USER node
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORTA||3001)+'/vivo').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/principal.js"]

FROM node:22-slim AS build
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @escritorio/trabalhador build
# Auditoria 4.3: a versão (resumo do código gerado) e a data do build vão na imagem. Com dois trabalhadores no mesmo banco,
# o de build mais antigo e versão diferente para de consumir; ninguém precisa informar nada a cada publicação.
RUN cd apps/trabalhador && find dist -type f -name '*.js' | sort | xargs sha256sum | sha256sum | cut -c1-12 > /build-versao \
  && date -u +%Y-%m-%dT%H:%M:%SZ > /build-em
RUN pnpm deploy --filter @escritorio/trabalhador --prod /saida

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /saida/node_modules ./node_modules
COPY --from=build --chown=node:node /repo/apps/trabalhador/dist ./dist
# Lidos na partida (src/instancia.ts, lerBuild) a partir de /app; VERSAO no ambiente sobrepõe a versão.
COPY --from=build --chown=node:node /build-versao ./versao
COPY --from=build --chown=node:node /build-em ./build_em
# Prontidão (D5): sem root; /vivo só diz que o processo responde (WhatsApp fora não reinicia o contêiner em laço).
USER node
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORTA||3001)+'/vivo').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/principal.js"]

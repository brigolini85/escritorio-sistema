# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_CHAVE_PUBLICA=
# Conexão direta ao Postgres (modo sessão, porta 5432) — usada pelo pg-boss
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Claude
ANTHROPIC_API_KEY=
# Z-API
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
WEBHOOK_SEGREDO=
# Opcional: domínios permitidos para baixar mídia (vírgula). Vazio = padrão da Z-API.
MIDIA_HOSTS_PERMITIDOS=
# Transcrição (API compatível com /audio/transcriptions)
TRANSCRICAO_BASE_URL=
TRANSCRICAO_API_KEY=
TRANSCRICAO_MODELO=
# Opcional: termos que ajudam a transcrição a acertar siglas (máx. ~224 tokens)
TRANSCRICAO_VOCABULARIO=
# E-mail (SMTP)
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
# Trabalhador
PORTA=3001
# Obrigatório: producao, homologacao ou local. Fora da produção, só os TELEFONES_PERMITIDOS recebem mensagem
# (o resto aparece no Atendimento como "Não enviada: ambiente de teste").
AMBIENTE=local
# Telefones que recebem mensagem fora da produção, separados por vírgula (ex.: 5531999990000,5531988880000).
TELEFONES_PERMITIDOS=
# Opcional: com ele, /saude?token=... (ou o cabeçalho x-saude-token) mostra o que falhou; sem ele, só { "ok": true|false }.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SAUDE_TOKEN=

# Painel
PAINEL_URL=http://localhost:3000
# Chave das senhas de portais (ficha do cliente): base64 de 32 bytes, diferente em cada ambiente e fora do banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sem ela, a ficha mostra os acessos, mas não guarda nem revela senhas. Perder a chave = cadastrar as senhas de novo.
ACESSOS_PORTAIS_CHAVE=
# Opcional (testes): endereços da busca pública de CNPJ e CEP. Vazio = BrasilAPI e ViaCEP.
CONSULTA_CNPJ_URL=
CONSULTA_CEP_URL=

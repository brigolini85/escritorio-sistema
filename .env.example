# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_CHAVE_PUBLICA=
# Conexão direta ao Postgres (modo sessão, porta 5432) — usada pelo pg-boss
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Claude
ANTHROPIC_API_KEY=
# Z-API
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
WEBHOOK_SEGREDO=
# Transcrição (API compatível com /audio/transcriptions)
TRANSCRICAO_BASE_URL=
TRANSCRICAO_API_KEY=
TRANSCRICAO_MODELO=
# Opcional: termos que ajudam a transcrição a acertar siglas (máx. ~224 tokens)
TRANSCRICAO_VOCABULARIO=
# E-mail (SMTP)
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
# Trabalhador
PORTA=3001

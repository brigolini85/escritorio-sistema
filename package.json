{
  "name": "plataforma-escritorio",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:test": "supabase test db",
    "db:tipos": "supabase gen types typescript --local > packages/db/src/tipos.gen.ts",
    "copia:fazer": "pnpm --filter @escritorio/copia fazer",
    "copia:restaurar": "pnpm --filter @escritorio/copia restaurar"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

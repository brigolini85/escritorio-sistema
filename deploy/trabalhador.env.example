# Variáveis do TRABALHADOR (Dockerfile.trabalhador) na PRODUÇÃO.
# Cole na aba "Environment" do app "trabalhador" no Easypanel, preenchendo os valores lá.
# NUNCA ponha valores reais neste arquivo (ele vai para o GitHub). Só nomes e explicações.
# Todas são obrigatórias, menos as marcadas "Opcional".

# Ambiente. Obrigatório, sem padrão: producao, homologacao ou local.
# Fora da produção, só os TELEFONES_PERMITIDOS recebem mensagem (o resto aparece no Atendimento como
# "Não enviada: ambiente de teste"). Sem ele o trabalhador não sobe.
AMBIENTE=producao
# Na produção fica vazio (todo mundo recebe). Na homologação: os celulares de teste, separados por vírgula.
TELEFONES_PERMITIDOS=

# Supabase da PRODUÇÃO (Project Settings > API e > Database). A service role ignora as regras de acesso: só aqui e no painel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta ao Postgres (modo sessão, porta 5432), usada pelo pg-boss (a fila).
DATABASE_URL=

# Claude: chave SÓ da produção (outra na homologação), criada no console da Anthropic com limite de gasto.
ANTHROPIC_API_KEY=

# Z-API: a instância conectada ao número do escritório.
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
# Segredo do webhook (recomendado 32 caracteres ou mais; o mínimo aceito é 16; diferente do da homologação). Vai no fim do endereço colado na Z-API.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WEBHOOK_SEGREDO=
# Opcional (auditoria 3.5): domínios de onde a mídia do cliente pode ser baixada, separados por vírgula. Vazio = z-api.io, backblazeb2.com, storage.googleapis.com.
MIDIA_HOSTS_PERMITIDOS=

# Transcrição de áudio (API compatível com /audio/transcriptions, ex.: Groq).
TRANSCRICAO_BASE_URL=
TRANSCRICAO_API_KEY=
TRANSCRICAO_MODELO=
# Opcional: termos que ajudam a transcrição a acertar siglas.
TRANSCRICAO_VOCABULARIO=

# Opcional: chave da conta de serviço do Google Drive (JSON inteiro ou em base64). Vazio = tarefas sem Drive.
GOOGLE_DRIVE_CONTA_SERVICO=

# E-mail (SMTP) dos alertas e do resumo diário.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=

# Opcional: com ele, https://<trabalhador>/saude?token=... mostra o que falhou; sem ele, /saude só diz { "ok": true|false }.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SAUDE_TOKEN=

# Porta interna do contêiner (o domínio do Easypanel aponta para ela).
PORTA=3001

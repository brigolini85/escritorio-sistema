# Variáveis do PAINEL (Dockerfile.painel) na PRODUÇÃO.
# Cole na aba "Environment" do app "painel" no Easypanel, preenchendo os valores lá.
# NUNCA ponha valores reais neste arquivo (ele vai para o GitHub). Só nomes e explicações.
#
# O painel NÃO recebe as chaves que só o trabalhador usa: Anthropic, Z-API, WEBHOOK_SEGREDO, transcrição (Groq),
# SMTP e Google Drive. Menos chaves no painel = menos estrago se ele for invadido.

# Ambiente: só o rótulo do topo (some na produção).
AMBIENTE=producao

# Supabase da PRODUÇÃO. As duas NEXT_PUBLIC_* são públicas por desenho (vão para o navegador) e entram
# TAMBÉM em "Build Arguments" do app no Easypanel: o Next grava o valor na hora do build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_CHAVE_PUBLICA=
# Chave mestra (ignora as regras de acesso): convites de usuário e tarefas do servidor do painel. Nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta ao Postgres (modo sessão, porta 5432). O painel precisa dela porque enfileira os trabalhos no
# pg-boss (apps/painel/src/lib/fila.ts): resposta da equipe ao cliente (enviar-mensagem), Assistente, testes do
# Treinar o agente, Sugerir resposta, tarefas, remoção de arquivos. O pg-boss só fala direto com o Postgres.
# (Trocar por um papel do banco limitado ao esquema pgboss fica para depois.)
DATABASE_URL=

# Endereço público do painel (com https://, sem barra no fim), usado nos links dos convites de usuário.
PAINEL_URL=

# Segredo do cookie de "último uso" do painel (a regra de 1 h sem uso). Auditoria 2.7: próprio, nunca a chave de serviço.
# Pelo menos 32 caracteres aleatórios, DIFERENTE da homologação. Sem ele o painel não sobe.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar o valor pede login de novo a quem entrou há mais de 1 h (a 1 h sem uso passa a contar desde o login).
PAINEL_SEGREDO_SESSAO=

# Chave das senhas de portais (ficha do cliente): base64 de 32 bytes, DIFERENTE da homologação e fora do banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde uma cópia fora do servidor: perder a chave = cadastrar as senhas de novo.
ACESSOS_PORTAIS_CHAVE=

# CONSULTA_CNPJ_URL e CONSULTA_CEP_URL: só para testes; na produção ficam de fora (BrasilAPI e ViaCEP).

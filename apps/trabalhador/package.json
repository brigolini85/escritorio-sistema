{
  "name": "@escritorio/trabalhador",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/principal.ts",
    "build": "tsup",
    "start": "node dist/principal.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cenarios": "tsx --env-file=../../.env src/cenarios/rodar.ts",
    "cenarios-atendimento": "tsx --env-file=../../.env src/cenarios/atendimento.ts",
    "cenarios-assistente": "tsx --env-file=../../.env src/cenarios/assistente.ts",
    "cenarios-pedir": "tsx --env-file=../../.env src/cenarios/pedir.ts",
    "cenarios-tarefas": "tsx --env-file=../../.env src/cenarios/tarefas.ts",
    "cenarios-radar": "tsx --env-file=../../.env src/cenarios/radar.ts",
    "seed-orientacoes-dono": "tsx src/agente/gerar-seed-skill-dono.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@escritorio/core": "workspace:*",
    "@escritorio/db": "workspace:*",
    "@supabase/supabase-js": "^2.47.0",
    "fastify": "^5.2.0",
    "fflate": "^0.8.2",
    "nodemailer": "^6.9.0",
    "pg-boss": "^10.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.0",
    "dotenv": "^16.4.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0"
  }
}

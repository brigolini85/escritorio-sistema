FROM node:22-slim AS build
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_CHAVE_PUBLICA
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL NEXT_PUBLIC_SUPABASE_CHAVE_PUBLICA=$NEXT_PUBLIC_SUPABASE_CHAVE_PUBLICA
RUN pnpm --filter @escritorio/painel build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /repo/apps/painel/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/painel/.next/static ./apps/painel/.next/static
# Prontidão (D5): sem root; a tela de entrada responder (qualquer código < 500) basta para dizer que o painel está de pé.
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/entrar',{redirect:'manual'}).then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/painel/server.js"]
